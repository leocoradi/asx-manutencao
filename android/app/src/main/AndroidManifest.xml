<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Botão "Procurar atualização": instala a versão nova do APK (o Android pede confirmação). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Pedido de isenção de otimização de bateria (a One UI suspende apps em segundo plano). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Para abrir o app de navegação e o YouTube Music a partir do web app. -->
    <queries>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <!-- Atalhos do Início no modo carro (mesma lista de Ponte.APPS). -->
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="app.vela" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.andrerinas.headunitrevived" />
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="headunit" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="false"
        android:allowBackup="false">

        <!-- smallestScreenSize em configChanges: entrar em tela dividida não recria a activity nem recarrega a WebView. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".InstalacaoReceiver" android:exported="false" />

        <!-- Acesso a notificações: lê a sessão de mídia (YouTube Music etc.) e a manobra do app de navegação. -->
        <service
            android:name=".NotificacoesService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
